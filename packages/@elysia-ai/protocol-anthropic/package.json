{
  "version": "0.3.0",
  "name": "@elysia-ai/protocol-anthropic",
  "description": "Elysia A.I. Anthropic Messages 协议包：maheshvara ↔ wire 的请求构造、响应解析与 SSE 流解码。与 Elysia-Api（Go）relay 层语义逐行为对齐。",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "type": "module",
  "types": "lib/index.d.ts",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/PinkElysiaDev/elysia-ai.git"
  },
  "homepage": "https://github.com/PinkElysiaDev/elysia-ai",
  "bugs": {
    "url": "https://github.com/PinkElysiaDev/elysia-ai/issues"
  },
  "author": "PinkElysiaDev",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.cjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@elysia-ai/maheshvara": "^0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "typescript": "^5.0.0"
  }
}
