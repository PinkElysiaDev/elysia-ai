{
  "version": "0.3.0",
  "name": "@elysia-ai/maheshvara",
  "description": "Elysia A.I. maheshvara 统一模型：跨协议（OpenAI Chat Completions / OpenAI Responses / Anthropic / Gemini）的请求、响应、流事件类型约定，以及与传输无关的 SSE 帧解析器。类型与 Elysia-Api（Go）relay 层的 maheshvara 规范逐字段对齐。",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "type": "module",
  "types": "lib/index.d.ts",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/PinkElysiaDev/elysia-ai.git"
  },
  "homepage": "https://github.com/PinkElysiaDev/elysia-ai",
  "bugs": {
    "url": "https://github.com/PinkElysiaDev/elysia-ai/issues"
  },
  "author": "PinkElysiaDev",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.cjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "typescript": "^5.0.0"
  }
}
