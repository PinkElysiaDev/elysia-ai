{
  "version": "0.1.1",
  "name": "@elysia-ai/kernel",
  "description": "Elysia A.I. 通用子框架内核：类型化事件总线、阶段化管线编排（DAG+优先级）、请求级上下文、生命周期相位、插件 manifest 兼容治理、trace 与测试 harness。零依赖、宿主无关，可独立于 AI 领域被任何 Koishi/cordis 应用复用。",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "type": "module",
  "types": "lib/index.d.ts",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/PinkElysiaDev/elysia-ai.git"
  },
  "homepage": "https://github.com/PinkElysiaDev/elysia-ai",
  "bugs": {
    "url": "https://github.com/PinkElysiaDev/elysia-ai/issues"
  },
  "author": "PinkElysiaDev",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.cjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "typescript": "^5.0.0"
  }
}
